Answer 404 for views of an unknown page

Counting a view of a page that does not exist returned 0, which hid
typos in the front end. record_view now raises PageNotFound and the
route answers 404.
---
diff --git a/src/shop/api.py b/src/shop/api.py
index ad5bdcc..13f6039 100644
--- a/src/shop/api.py
+++ b/src/shop/api.py
@@ -3,12 +3,12 @@
 import os
 from typing import Annotated
 
-from fastapi import Depends, FastAPI
+from fastapi import Depends, FastAPI, HTTPException
 from pydantic import BaseModel
 from pymongo import MongoClient
 from pymongo.collection import Collection
 
-from shop.pages import PageDoc, record_view
+from shop.pages import PageDoc, PageNotFound, record_view
 
 app = FastAPI()
 _mongo: MongoClient[PageDoc] | None = None
@@ -30,4 +30,8 @@ class ViewsOut(BaseModel):
 def count_view(
     slug: str, pages: Annotated[Collection[PageDoc], Depends(get_pages)]
 ) -> ViewsOut:
-    return ViewsOut(slug=slug, views=record_view(pages, slug))
+    try:
+        views = record_view(pages, slug)
+    except PageNotFound:
+        raise HTTPException(status_code=404, detail="no such page") from None
+    return ViewsOut(slug=slug, views=views)

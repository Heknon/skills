new file mode 100644
index 0000000..cdeb613
--- /dev/null
+++ b/src/shop/repository.py
@@ -0,0 +1,29 @@
+"""Where orders are kept and read. The database will replace ORDERS here."""
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Order:
+    id: str
+    customer_id: str
+    total_cents: int
+    status: str  # "paid", "shipped" or "cancelled"
+
+
+ORDERS = [
+    Order("o-1", "c-1", 2_000, "paid"),
+    Order("o-2", "c-1", 3_500, "shipped"),
+    Order("o-3", "c-2", 1_200, "paid"),
+    Order("o-4", "c-2", 9_900, "cancelled"),
+]
+
+
+def list_orders(customer_id: str, include_cancelled: bool = True) -> list[Order]:
+    """The customer's orders, filtered by status."""
+    return [
+        order
+        for order in ORDERS
+        if order.customer_id == customer_id
+        and (include_cancelled or order.status != "cancelled")
+    ]

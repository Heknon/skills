Address review: refuse non-positive transfers, test the balance check

Findings 1 and 3 of the first review.
---
diff --git a/src/shop/points.py b/src/shop/points.py
index 07e3cd9..f3ce6e9 100644
--- a/src/shop/points.py
+++ b/src/shop/points.py
@@ -26,7 +26,9 @@ def audit(line: str) -> None:
 
 def transfer_points(src: Account, dst: Account, points: int) -> None:
     """Move points from src to dst. The whole balance may be moved."""
-    if src.balance < points:
+    if points <= 0:
+        raise ValueError(f"points must be positive, got {points}")
+    if src.balance <= points:
         raise InsufficientPoints(src.id)
     src.balance -= points
     dst.balance += points

Look up a user by email

Support searches users by email when a customer calls.
---
diff --git a/src/shop/api.py b/src/shop/api.py
index 49ea698..f3ebdfd 100644
--- a/src/shop/api.py
+++ b/src/shop/api.py
@@ -45,3 +45,11 @@ async def read_user(
 
 app = FastAPI(lifespan=lifespan)
 app.include_router(router)
+
+
+@router.get("/users/by-email/{email}")
+async def read_user_by_email(email: str) -> User:
+    user = await User.find_one(User.email == email)
+    if user is None:
+        raise HTTPException(status_code=404, detail="user not found")
+    return user

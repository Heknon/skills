Name loggers logger, add the loyalty discount, round VAT half up

The style guide names module loggers `logger`. Finance asked for the
loyalty discount and for VAT rounded half up from next month.
---
diff --git a/src/shop/discounts.py b/src/shop/discounts.py
index 46513c6..9adcad4 100644
--- a/src/shop/discounts.py
+++ b/src/shop/discounts.py
@@ -1,8 +1,19 @@
 """Discounts on an order total."""
 
+LOYALTY_ORDERS = 10
+LOYALTY_PERCENT = 5
 
-def discounted_cents(total_cents: int, coupon: str | None) -> int:
-    """The total after a coupon: WELCOME10 takes 10% off."""
+
+def discounted_cents(
+    total_cents: int, coupon: str | None, order_count: int = 0
+) -> int:
+    """The total after discounts.
+
+    WELCOME10 takes 10% off. Customers with 10 or more earlier orders get
+    another 5% off, after the coupon.
+    """
     if coupon == "WELCOME10":
-        return total_cents - total_cents // 10
+        total_cents -= total_cents // 10
+    if order_count > LOYALTY_ORDERS:
+        total_cents -= total_cents * LOYALTY_PERCENT // 100
     return total_cents

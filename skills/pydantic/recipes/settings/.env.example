# Copy to .env for local development. Never commit .env.
# Every key the app reads starts with APP_; other tools' keys may share
# this file (dotenv_filtering="match_prefix" ignores them).
APP_ENVIRONMENT=dev
APP_PORT=8000
APP_LOG_LEVEL=debug
APP_DB__HOST=localhost
APP_DB__NAME=app
APP_DB__USER=app
# In the cluster the password comes from the file secrets/app_db_password;
# for local work it may be set here.
APP_DB_PASSWORD=change-me
